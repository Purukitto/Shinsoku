{
  "manifest_version": 3,
  "name": "Shinsoku Capture",
  "version": "0.1.0",
  "description": "Send browser downloads to the Shinsoku download manager.",
  "permissions": ["downloads", "cookies", "storage", "notifications", "webRequest", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": { "scripts": ["common.js", "background.js"] },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Shinsoku — detected streams",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "shinsoku-capture@purukitto.xyz",
      "strict_min_version": "115.0"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
