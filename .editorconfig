root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.rs]
indent_size = 4

[*.{ps1,cmd,bat}]
end_of_line = crlf
indent_size = unset

[*.md]
trim_trailing_whitespace = false

[*.{png,jpg,ico,ttf,webp}]
insert_final_newline = false
trim_trailing_whitespace = false
